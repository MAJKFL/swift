// RUN: %target-sil-opt -sil-print-types -address-lowering -enable-sil-opaque-values -enable-experimental-feature MoveOnlyEnumDeinits -module-name Swift -sil-verify-all %s | %FileCheck %s

// REQUIRES: swift_feature_MoveOnlyEnumDeinits

import Builtin

sil_stage raw

protocol P {}

class Klass {}

struct NCS<T> : ~Copyable {
  var t: T
  var k: Klass
  deinit
}

enum NCE<T> : ~Copyable {
  case some(T)
  case ref(Klass)
  case none
  deinit
}

// CHECK-LABEL: sil [ossa] @drop_deinit_struct_destroy : $@convention(thin) <T> (@in NCS<T>) -> () {
// CHECK:       bb0(%0 : $*NCS<T>):
// CHECK-NEXT:    [[D:%.*]] = drop_deinit %0 : $*NCS<T>
// CHECK-DAG:     [[K:%.*]] = struct_element_addr [[D]] : $*NCS<T>, #NCS.k
// CHECK-DAG:     [[KV:%.*]] = load [take] [[K]] : $*Klass
// CHECK-DAG:     [[T:%.*]] = struct_element_addr [[D]] : $*NCS<T>, #NCS.t
// CHECK-DAG:     destroy_addr [[T]] : $*T
// CHECK-DAG:     destroy_value [[KV]] : $Klass
// CHECK-NOT:     destroy_addr
// CHECK-LABEL: } // end sil function 'drop_deinit_struct_destroy'
sil [ossa] @drop_deinit_struct_destroy : $@convention(thin) <T> (@in NCS<T>) -> () {
bb0(%0 : @owned $NCS<T>):
  %1 = drop_deinit %0 : $NCS<T>
  destroy_value %1 : $NCS<T>
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @drop_deinit_struct_destructure : $@convention(thin) <T> (@in NCS<T>) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : $*NCS<T>):
// CHECK-NEXT:    [[D:%.*]] = drop_deinit %1 : $*NCS<T>
// CHECK:         [[T:%.*]] = struct_element_addr [[D]] : $*NCS<T>, #NCS.t
// CHECK-NEXT:    copy_addr [take] [[T]] to [init] %0 : $*T
// CHECK-LABEL: } // end sil function 'drop_deinit_struct_destructure'
sil [ossa] @drop_deinit_struct_destructure : $@convention(thin) <T> (@in NCS<T>) -> @out T {
bb0(%0 : @owned $NCS<T>):
  %1 = drop_deinit %0 : $NCS<T>
  (%2, %3) = destructure_struct %1 : $NCS<T>
  destroy_value %3 : $Klass
  return %2 : $T
}

// CHECK-LABEL: sil [ossa] @drop_deinit_enum_destroy : $@convention(thin) <T> (@in NCE<T>) -> () {
// CHECK:       bb0(%0 : $*NCE<T>):
// CHECK-NEXT:    [[D:%.*]] = drop_deinit %0 : $*NCE<T>
// CHECK-NEXT:    switch_enum_addr [[D]] : $*NCE<T>, case #NCE.some!enumelt: [[SOME:bb[0-9]+]], case #NCE.ref!enumelt: [[REF:bb[0-9]+]], case #NCE.none!enumelt: [[NONE:bb[0-9]+]]
// CHECK:       [[SOME]]:
// CHECK-NEXT:    [[P:%.*]] = unchecked_inplace_enum_data_addr [[D]] : $*NCE<T>, #NCE.some!enumelt
// CHECK-NEXT:    destroy_addr [[P]] : $*T
// CHECK:       [[REF]]:
// CHECK-NEXT:    [[R:%.*]] = unchecked_inplace_enum_data_addr [[D]] : $*NCE<T>, #NCE.ref!enumelt
// CHECK-NEXT:    [[RV:%.*]] = load [take] [[R]] : $*Klass
// CHECK-NEXT:    destroy_value [[RV]] : $Klass
// CHECK:       [[NONE]]:
// CHECK-NEXT:    br
// CHECK-NOT:     destroy_addr
// CHECK-LABEL: } // end sil function 'drop_deinit_enum_destroy'
sil [ossa] @drop_deinit_enum_destroy : $@convention(thin) <T> (@in NCE<T>) -> () {
bb0(%0 : @owned $NCE<T>):
  %1 = drop_deinit %0 : $NCE<T>
  destroy_value %1 : $NCE<T>
  %r = tuple ()
  return %r : $()
}
