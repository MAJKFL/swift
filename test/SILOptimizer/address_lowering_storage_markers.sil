// RUN: %empty-directory(%t)
// RUN: %target-swift-frontend -enable-experimental-com-interop -module-name COM -emit-module-path %t/COM.swiftmodule %S/../Inputs/COM.swift
// RUN: %target-sil-opt -enable-experimental-com-interop -I %t -address-lowering -enable-sil-opaque-values -sil-print-types -sil-verify-all %s | %FileCheck %s

// A COM-constrained generic is address-only even when it is class-bound.

sil_stage raw
import Swift
import Builtin
import COM

@com(interface: "10000000-0000-0000-0000-000000000001")
public protocol IItem {}

@com(interface: "10000000-0000-0000-0000-000000000002")
public protocol IClassItem: IItem, AnyObject {}

sil @takeGuaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()

// CHECK-LABEL: sil [ossa] @end_cow_mutation : $@convention(thin) <T> (@inout T) -> () {
// CHECK:       bb0(%0 : $*T):
// CHECK:         [[A:%.*]] = alloc_stack $T
// CHECK:         copy_addr [take] %0 to [init] [[A]] : $*T
// CHECK-NEXT:    end_cow_mutation_addr [[A]] : $*T
// CHECK-NEXT:    copy_addr [take] [[A]] to [init] %0 : $*T
// CHECK-LABEL: } // end sil function 'end_cow_mutation'
sil [ossa] @end_cow_mutation : $@convention(thin) <T> (@inout T) -> () {
bb0(%0 : $*T):
  %1 = load [take] %0 : $*T
  %2 = end_cow_mutation %1 : $T
  store %2 to [init] %0 : $*T
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @end_init_let_ref : $@convention(thin) <T where T : IClassItem> (@in T) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : $*T):
// CHECK-NEXT:    copy_addr [take] %1 to [init] %0 : $*T
// CHECK-NEXT:    tuple ()
// CHECK-LABEL: } // end sil function 'end_init_let_ref'
sil [ossa] @end_init_let_ref : $@convention(thin) <T: IClassItem> (@in T) -> @out T {
bb0(%0 : @owned $T):
  %1 = end_init_let_ref %0 : $T
  return %1 : $T
}

// CHECK-LABEL: sil [ossa] @cow_buffer_for_reading : $@convention(thin) <T where T : IClassItem> (@in T) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : $*T):
// CHECK-NEXT:    copy_addr [take] %1 to [init] %0 : $*T
// CHECK-NEXT:    tuple ()
// CHECK-LABEL: } // end sil function 'cow_buffer_for_reading'
sil [ossa] @cow_buffer_for_reading : $@convention(thin) <T: IClassItem> (@in T) -> @out T {
bb0(%0 : @owned $T):
  %1 = builtin "COWBufferForReading"<T>(%0 : $T) : $T
  return %1 : $T
}

// CHECK-LABEL: sil [ossa] @cow_buffer_for_reading_local : $@convention(thin) <T where T : IClassItem> (@in T) -> () {
// CHECK:       bb0(%0 : $*T):
// CHECK-NOT:     builtin
// CHECK:         apply %{{.*}}<T>(%0)
// CHECK-NEXT:    destroy_addr %0 : $*T
// CHECK-LABEL: } // end sil function 'cow_buffer_for_reading_local'
sil [ossa] @cow_buffer_for_reading_local : $@convention(thin) <T: IClassItem> (@in T) -> () {
bb0(%0 : @owned $T):
  %1 = builtin "COWBufferForReading"<T>(%0 : $T) : $T
  %2 = function_ref @takeGuaranteed : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %3 = apply %2<T>(%1) : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  destroy_value %1 : $T
  %r = tuple ()
  return %r : $()
}
