// RUN: %empty-directory(%t)
// RUN: %target-swift-frontend -enable-experimental-com-interop -module-name COM -emit-module-path %t/COM.swiftmodule %S/../Inputs/COM.swift
// RUN: %target-sil-opt -enable-experimental-com-interop -I %t -address-lowering -enable-sil-opaque-values -sil-print-types -sil-verify-all %s | %FileCheck %s

// A COM-constrained generic is address-only even when it is class-bound.

sil_stage raw
import Swift
import Builtin
import COM

@com(interface: "10000000-0000-0000-0000-000000000001")
public protocol IItem {}

@com(interface: "10000000-0000-0000-0000-000000000002")
public protocol IClassItem: IItem, AnyObject {}

sil @takeGuaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()

// CHECK-LABEL: sil [ossa] @unchecked_ref_cast_to_object : $@convention(thin) <T where T : IClassItem> (@in T) -> @owned AnyObject {
// CHECK:       bb0(%0 : $*T):
// CHECK-NEXT:    [[V:%.*]] = unchecked_addr_cast %0 : $*T to $*AnyObject
// CHECK-NEXT:    [[L:%.*]] = load [take] [[V]] : $*AnyObject
// CHECK-NEXT:    return [[L]] : $AnyObject
// CHECK-LABEL: } // end sil function 'unchecked_ref_cast_to_object'
sil [ossa] @unchecked_ref_cast_to_object : $@convention(thin) <T: IClassItem> (@in T) -> @owned AnyObject {
bb0(%0 : @owned $T):
  %1 = unchecked_ref_cast %0 : $T to $AnyObject
  return %1 : $AnyObject
}

// CHECK-LABEL: sil [ossa] @unchecked_ref_cast_from_object : $@convention(thin) <T where T : IClassItem> (@owned AnyObject) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : @owned $AnyObject):
// CHECK-NEXT:    [[V:%.*]] = unchecked_addr_cast %0 : $*T to $*AnyObject
// CHECK-NEXT:    store %1 to [init] [[V]] : $*AnyObject
// CHECK-LABEL: } // end sil function 'unchecked_ref_cast_from_object'
sil [ossa] @unchecked_ref_cast_from_object : $@convention(thin) <T: IClassItem> (@owned AnyObject) -> @out T {
bb0(%0 : @owned $AnyObject):
  %1 = unchecked_ref_cast %0 : $AnyObject to $T
  return %1 : $T
}

// CHECK-LABEL: sil [ossa] @unchecked_ref_cast_from_object_guaranteed : $@convention(thin) <T where T : IClassItem> (@guaranteed AnyObject) -> () {
// CHECK:       bb0(%0 : @guaranteed $AnyObject):
// CHECK:         [[A:%.*]] = alloc_stack $T
// CHECK:         [[V:%.*]] = unchecked_addr_cast [[A]] : $*T to $*AnyObject
// CHECK:         [[C:%.*]] = unchecked_ownership_conversion %0 : $AnyObject, @guaranteed to @owned
// CHECK:         store [[C]] to [init] [[V]] : $*AnyObject
// CHECK:         apply %{{.*}}<T>([[A]])
// CHECK-NOT:     destroy_addr
// CHECK-LABEL: } // end sil function 'unchecked_ref_cast_from_object_guaranteed'
sil [ossa] @unchecked_ref_cast_from_object_guaranteed : $@convention(thin) <T: IClassItem> (@guaranteed AnyObject) -> () {
bb0(%0 : @guaranteed $AnyObject):
  %1 = unchecked_ref_cast %0 : $AnyObject to $T
  %2 = function_ref @takeGuaranteed : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %3 = apply %2<T>(%1) : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @unchecked_ref_cast_opaque : $@convention(thin) <T, U where T : IClassItem, U : IClassItem> (@in T) -> @out U {
// CHECK:       bb0(%0 : $*U, %1 : $*T):
// CHECK-NEXT:    [[V:%.*]] = unchecked_addr_cast %1 : $*T to $*U
// CHECK-NEXT:    copy_addr [take] [[V]] to [init] %0 : $*U
// CHECK-LABEL: } // end sil function 'unchecked_ref_cast_opaque'
sil [ossa] @unchecked_ref_cast_opaque : $@convention(thin) <T: IClassItem, U: IClassItem> (@in T) -> @out U {
bb0(%0 : @owned $T):
  %1 = unchecked_ref_cast %0 : $T to $U
  return %1 : $U
}

// CHECK-LABEL: sil [ossa] @ref_to_raw_pointer : $@convention(thin) <T where T : IClassItem> (@in_guaranteed T) -> Builtin.RawPointer {
// CHECK:       bb0(%0 : $*T):
// CHECK-NEXT:    [[V:%.*]] = unchecked_addr_cast %0 : $*T to $*Builtin.RawPointer
// CHECK-NEXT:    [[L:%.*]] = load [trivial] [[V]] : $*Builtin.RawPointer
// CHECK-NEXT:    return [[L]] : $Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'ref_to_raw_pointer'
sil [ossa] @ref_to_raw_pointer : $@convention(thin) <T: IClassItem> (@in_guaranteed T) -> Builtin.RawPointer {
bb0(%0 : @guaranteed $T):
  %1 = ref_to_raw_pointer %0 : $T to $Builtin.RawPointer
  return %1 : $Builtin.RawPointer
}

// The +1 result is a copy through T's value witness.
// CHECK-LABEL: sil [ossa] @raw_pointer_to_ref : $@convention(thin) <T where T : IClassItem> (Builtin.RawPointer) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : $Builtin.RawPointer):
// CHECK-NEXT:    [[A:%.*]] = alloc_stack $Builtin.RawPointer
// CHECK-NEXT:    store %1 to [trivial] [[A]] : $*Builtin.RawPointer
// CHECK-NEXT:    [[V:%.*]] = unchecked_addr_cast [[A]] : $*Builtin.RawPointer to $*T
// CHECK-NEXT:    copy_addr [[V]] to [init] %0 : $*T
// CHECK-NEXT:    dealloc_stack [[A]] : $*Builtin.RawPointer
// CHECK-LABEL: } // end sil function 'raw_pointer_to_ref'
sil [ossa] @raw_pointer_to_ref : $@convention(thin) <T: IClassItem> (Builtin.RawPointer) -> @out T {
bb0(%0 : $Builtin.RawPointer):
  %1 = raw_pointer_to_ref %0 : $Builtin.RawPointer to $T
  return %1 : $T
}

// CHECK-LABEL: sil [ossa] @raw_pointer_to_ref_immortal : $@convention(thin) <T where T : IClassItem> (Builtin.RawPointer) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : $Builtin.RawPointer):
// CHECK:         [[A:%.*]] = alloc_stack $T
// CHECK:         [[V:%.*]] = unchecked_addr_cast [[A]] : $*T to $*Builtin.RawPointer
// CHECK:         store %1 to [trivial] [[V]] : $*Builtin.RawPointer
// CHECK:         copy_addr [[A]] to [init] %0 : $*T
// CHECK-NOT:     destroy_addr
// CHECK-LABEL: } // end sil function 'raw_pointer_to_ref_immortal'
sil [ossa] @raw_pointer_to_ref_immortal : $@convention(thin) <T: IClassItem> (Builtin.RawPointer) -> @out T {
bb0(%0 : $Builtin.RawPointer):
  %1 = raw_pointer_to_ref [immortal] %0 : $Builtin.RawPointer to $T
  %2 = copy_value %1 : $T
  return %2 : $T
}
