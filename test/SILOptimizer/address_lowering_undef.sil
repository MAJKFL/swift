sil [ossa] @unchecked_bitwise_cast : $@convention(thin) <T, U> () -> @out U {
bb0:
  %0 = unchecked_bitwise_cast undef : $T to $U
  %1 = copy_value %0 : $U
  return %1 : $U
}

// CHECK-LABEL: sil [ossa] @unchecked_value_cast_loadable : $@convention(thin) <T> () -> () {
// CHECK:       bb0:
// CHECK:         [[F:%.*]] = function_ref @consumeKlass
// CHECK-NEXT:    apply [[F]](undef) : $@convention(thin) (@owned Klass) -> ()
