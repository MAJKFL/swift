// CHECK-LABEL: sil [ossa] @return_value : $@convention(thin) <T> () -> @out T {
// CHECK:       bb0(%0 : $*T):
// CHECK-NEXT:    copy_addr [take] undef to [init] %0 : $*T
// CHECK-LABEL: } // end sil function 'return_value'
sil [ossa] @return_value : $@convention(thin) <T> () -> @out T {
bb0:
  return undef : $T
}

// CHECK-LABEL: sil [ossa] @phi : $@convention(thin) <T> (@in T) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : $*T):
// CHECK:       bb1:
// CHECK-NEXT:    copy_addr [take] %1 to [init] %0 : $*T
// CHECK:       bb2:
// CHECK-NEXT:    destroy_addr %1 : $*T
// CHECK-NEXT:    copy_addr [take] undef to [init] %0 : $*T
// CHECK-LABEL: } // end sil function 'phi'
sil [ossa] @phi : $@convention(thin) <T> (@in T) -> @out T {
bb0(%0 : @owned $T):
  cond_br undef, bb1, bb2
bb1:
  br bb3(%0 : $T)
bb2:
  destroy_value %0 : $T
  br bb3(undef : $T)
bb3(%1 : @owned $T):
  return %1 : $T
}

// CHECK-LABEL: sil [ossa] @yield : $@yield_once @convention(thin) <T> () -> @yields @in_guaranteed T {
// CHECK:       bb0:
// CHECK-NEXT:    yield undef : $*T, resume bb1, unwind bb2
// CHECK-LABEL: } // end sil function 'yield'
sil [ossa] @yield : $@yield_once @convention(thin) <T> () -> @yields @in_guaranteed T {
bb0:
  yield undef : $T, resume bb1, unwind bb2
bb1:
  %r = tuple ()
  return %r : $()
bb2:
  unwind
}

