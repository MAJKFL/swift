sil [ossa] @unchecked_value_cast_loadable : $@convention(thin) <T> () -> () {
bb0:
  %0 = unchecked_value_cast undef : $T to $Klass
  %f = function_ref @consumeKlass : $@convention(thin) (@owned Klass) -> ()
  %a = apply %f(%0) : $@convention(thin) (@owned Klass) -> ()
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @open_existential_value : $@convention(thin) () -> () {
// CHECK:       bb0:
// CHECK-NEXT:    [[O:%.*]] = open_existential_addr immutable_access undef : $*any P to $*@opened(1, any P) Self
// CHECK:         function_ref @borrowT
// CHECK-NEXT:    apply %{{.*}}<@opened(1, any P) Self>([[O]])
// CHECK-LABEL: } // end sil function 'open_existential_value'
sil [ossa] @open_existential_value : $@convention(thin) () -> () {
bb0:
  %0 = open_existential_value undef : $any P to $@opened(1, any P) Self
  %f = function_ref @borrowT : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %a = apply %f<@opened(1, any P) Self>(%0) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @copyable_to_moveonlywrapper : $@convention(thin) <T> () -> () {
// CHECK:       bb0:
// CHECK-NEXT:    [[W:%.*]] = copyable_to_moveonlywrapper_addr undef : $*T
// CHECK-NEXT:    [[C:%.*]] = moveonlywrapper_to_copyable_addr [[W]] : $*@moveOnly T
