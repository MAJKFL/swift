// CHECK-LABEL: sil [ossa] @struct_operand : $@convention(thin) <T> (@owned Klass) -> @out S<T> {
// CHECK:       bb0(%0 : $*S<T>, %1 : @owned $Klass):
// CHECK-NEXT:    [[T:%.*]] = struct_element_addr %0 : $*S<T>, #S.t
// CHECK-NEXT:    copy_addr [take] undef to [init] [[T]] : $*T
// CHECK-NEXT:    [[K:%.*]] = struct_element_addr %0 : $*S<T>, #S.k
// CHECK-NEXT:    store %1 to [init] [[K]] : $*Klass
// CHECK-LABEL: } // end sil function 'struct_operand'
sil [ossa] @struct_operand : $@convention(thin) <T> (@owned Klass) -> @out S<T> {
bb0(%0 : @owned $Klass):
  %1 = struct $S<T> (undef : $T, %0 : $Klass)
  return %1 : $S<T>
}

// CHECK-LABEL: sil [ossa] @tuple_operand : $@convention(thin) <T> () -> @out (T, T) {
// CHECK:       bb0(%0 : $*(T, T)):
// CHECK-NEXT:    [[T0:%.*]] = tuple_element_addr %0 : $*(T, T), 0
// CHECK-NEXT:    copy_addr [take] undef to [init] [[T0]] : $*T
// CHECK-NEXT:    [[T1:%.*]] = tuple_element_addr %0 : $*(T, T), 1
// CHECK-NEXT:    copy_addr [take] undef to [init] [[T1]] : $*T
// CHECK-LABEL: } // end sil function 'tuple_operand'
sil [ossa] @tuple_operand : $@convention(thin) <T> () -> @out (T, T) {
bb0:
  %0 = tuple (undef : $T, undef : $T)
  return %0 : $(T, T)
}

