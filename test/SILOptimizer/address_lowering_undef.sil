  %f = function_ref @consumeT : $@convention(thin) <T> (@in T) -> ()
  %a = apply %f<T>(undef) : $@convention(thin) <T> (@in T) -> ()
  %g = function_ref @borrowT : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %b = apply %g<T>(undef) : $@convention(thin) <T> (@in_guaranteed T) -> ()
  %r = tuple ()
