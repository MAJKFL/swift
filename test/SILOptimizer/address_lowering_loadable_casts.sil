// RUN: %target-sil-opt -sil-print-types -address-lowering -enable-sil-opaque-values -module-name Swift -sil-verify-all %s | %FileCheck %s

import Builtin

sil_stage raw

class Klass {}

sil @takeGuaranteed : $@convention(thin) <T> (@in_guaranteed T) -> ()

// The cast does not consume its operand, so the stored bitwise copy must not.
// CHECK-LABEL: sil [ossa] @unchecked_bitwise_cast_guaranteed : $@convention(thin) <T> (@guaranteed Klass) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : @guaranteed $Klass):
// CHECK:         [[A:%.*]] = alloc_stack $T
// CHECK:         [[V:%.*]] = unchecked_addr_cast [[A]] : $*T to $*Klass
// CHECK:         [[C:%.*]] = unchecked_ownership_conversion %1 : $Klass, @guaranteed to @owned
// CHECK:         store [[C]] to [init] [[V]] : $*Klass
// CHECK:         copy_addr [[A]] to [init] %0 : $*T
// CHECK-LABEL: } // end sil function 'unchecked_bitwise_cast_guaranteed'
sil [ossa] @unchecked_bitwise_cast_guaranteed : $@convention(thin) <T> (@guaranteed Klass) -> @out T {
bb0(%0 : @guaranteed $Klass):
  %1 = unchecked_bitwise_cast %0 : $Klass to $T
  %2 = copy_value %1 : $T
  return %2 : $T
}

// CHECK-LABEL: sil [ossa] @unchecked_bitwise_cast_owned : $@convention(thin) <T> (@owned Klass) -> @out T {
// CHECK:       bb0(%0 : $*T, %1 : @owned $Klass):
// CHECK:         [[C:%.*]] = unchecked_ownership_conversion %1 : $Klass, @owned to @owned
// CHECK:         store [[C]] to [init] %{{.*}} : $*Klass
// CHECK:         destroy_value %1 : $Klass
// CHECK-LABEL: } // end sil function 'unchecked_bitwise_cast_owned'
sil [ossa] @unchecked_bitwise_cast_owned : $@convention(thin) <T> (@owned Klass) -> @out T {
bb0(%0 : @owned $Klass):
  %1 = unchecked_bitwise_cast %0 : $Klass to $T
  %2 = copy_value %1 : $T
  destroy_value %0 : $Klass
  return %2 : $T
}

// CHECK-LABEL: sil [ossa] @unchecked_value_cast_guaranteed : $@convention(thin) <T> (@guaranteed Klass) -> () {
// CHECK:       bb0(%0 : @guaranteed $Klass):
// CHECK:         [[A:%.*]] = alloc_stack $T
// CHECK:         [[V:%.*]] = unchecked_addr_cast [[A]] : $*T to $*Klass
// CHECK:         [[C:%.*]] = unchecked_ownership_conversion %0 : $Klass, @guaranteed to @owned
// CHECK:         store [[C]] to [init] [[V]] : $*Klass
// CHECK:         apply %{{.*}}<T>([[A]])
// CHECK-NOT:     destroy_addr
// CHECK-LABEL: } // end sil function 'unchecked_value_cast_guaranteed'
sil [ossa] @unchecked_value_cast_guaranteed : $@convention(thin) <T> (@guaranteed Klass) -> () {
bb0(%0 : @guaranteed $Klass):
  %1 = unchecked_value_cast %0 : $Klass to $T
  %2 = function_ref @takeGuaranteed : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %3 = apply %2<T>(%1) : $@convention(thin) <τ_0_0> (@in_guaranteed τ_0_0) -> ()
  %r = tuple ()
  return %r : $()
}

// CHECK-LABEL: sil [ossa] @unchecked_value_cast_owned_to_loadable : $@convention(thin) <T> (@in T) -> @owned Klass {
// CHECK:       bb0(%0 : $*T):
// CHECK-NEXT:    [[V:%.*]] = unchecked_addr_cast %0 : $*T to $*Klass
// CHECK-NEXT:    [[L:%.*]] = load [take] [[V]] : $*Klass
// CHECK-NEXT:    return [[L]] : $Klass
// CHECK-LABEL: } // end sil function 'unchecked_value_cast_owned_to_loadable'
sil [ossa] @unchecked_value_cast_owned_to_loadable : $@convention(thin) <T> (@in T) -> @owned Klass {
bb0(%0 : @owned $T):
  %1 = unchecked_value_cast %0 : $T to $Klass
  return %1 : $Klass
}
